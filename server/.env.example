# Copy this file to .env (never commit .env) and fill the values.

PORT=8787

# Bank identity (must match src/bank-config.js in the portal)
BANK_ID=P663
BANK_NAME=The North Bank
IFSC=MAHA0K6P3DY

# Safety check: the service-account key must belong to THIS Firebase project, otherwise the server refuses to start.
EXPECTED_PROJECT_ID=the-north-bank
# Path to the service-account key you download from Firebase (keep it outside Git, e.g. server/secrets/key.json)
SERVICE_ACCOUNT_PATH=./secrets/key.json

# The one pre-created bank administrator (choose your own strong password)
ADMIN_EMAIL=admin@thenorthbank.example
ADMIN_PASSWORD=change-this-password

# Browsers allowed to call this server (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,https://mahalakshmi-vetrivel.github.io
# Where customers sign in (used in e-mails)
PORTAL_URL=https://mahalakshmi-vetrivel.github.io/the-north-bank/

# E-mail (optional). Leave SMTP_HOST empty to only LOG e-mails (they still show in the admin "Emails" tab).
# For Gmail use smtp.gmail.com, port 465, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The North Bank <no-reply@thenorthbank.example>"
